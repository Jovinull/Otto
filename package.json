{
  "name": "otto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assistente financeiro familiar conversacional sobre Telegram e Cloudflare Workers",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --persist-to .wrangler/state",
    "build": "wrangler deploy --dry-run --outdir dist --env production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:scripts && pnpm build",
    "types": "wrangler types --env-interface Env src/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "deploy:prod": "wrangler deploy --env production",
    "simulate": "node scripts/simulate-telegram.mjs",
    "bootstrap:household": "node scripts/bootstrap-household.mjs",
    "telegram:webhook": "node scripts/set-webhook.mjs",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "doctor": "node scripts/doctor.mjs",
    "doctor:telegram": "node scripts/doctor-telegram.mjs",
    "smoke:openai": "tsx scripts/smoke-openai.ts",
    "eval:openai": "tsx scripts/eval-openai.ts",
    "backup:prod": "node scripts/backup.mjs",
    "backup:local": "node scripts/backup.mjs --local",
    "restore:test": "node scripts/restore-test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
