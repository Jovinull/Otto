# Usado apenas pelos scripts em scripts/ na sua maquina. Copie para .env e preencha.
# Em producao os segredos ficam em `wrangler secret put` (ver docs/deployment.md).

# URL publica do Worker, ex.: https://otto.SEU-SUBDOMINIO.workers.dev
OTTO_BASE_URL=

# Mesmos valores cadastrados via `wrangler secret put`
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_API_TOKEN=

# Dados do bootstrap (descubra com /id no grupo, ver docs/telegram-setup.md)
OTTO_HOUSEHOLD_NAME=
OTTO_TIMEZONE=America/Maceio
OTTO_TELEGRAM_CHAT_ID=
OTTO_MEMBER_1_NAME=
OTTO_MEMBER_1_TELEGRAM_ID=
OTTO_MEMBER_2_NAME=
OTTO_MEMBER_2_TELEGRAM_ID=
